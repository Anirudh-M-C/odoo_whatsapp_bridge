<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_whatsapp_conversation_list" model="ir.ui.view">
        <field name="name">whatsapp.conversation.list</field>
        <field name="model">whatsapp.conversation</field>
        <field name="arch" type="xml">
            <list string="Conversations" default_order="last_message_at desc">
                <field name="partner_phone"/>
                <field name="last_message_preview"/>
                <field name="state" widget="badge"
                       decoration-warning="state == 'pending_human'"
                       decoration-info="state == 'human_handling'"
                       decoration-success="state == 'ai_handling'"
                       decoration-muted="state == 'closed'"/>
                <field name="assigned_user_id"/>
                <field name="last_message_at"/>
            </list>
        </field>
    </record>

    <record id="view_whatsapp_conversation_kanban" model="ir.ui.view">
        <field name="name">whatsapp.conversation.kanban</field>
        <field name="model">whatsapp.conversation</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column">
                <field name="partner_phone"/>
                <field name="last_message_preview"/>
                <field name="assigned_user_id"/>
                <field name="last_message_at"/>
                <field name="state"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_card oe_kanban_global_click">
                            <strong><field name="partner_phone"/></strong>
                            <div class="text-muted">
                                <field name="last_message_preview"/>
                            </div>
                            <div class="d-flex justify-content-between align-items-center mt-1">
                                <field name="assigned_user_id" widget="many2one_avatar_user"/>
                                <field name="last_message_at"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_whatsapp_conversation_form" model="ir.ui.view">
        <field name="name">whatsapp.conversation.form</field>
        <field name="model">whatsapp.conversation</field>
        <field name="arch" type="xml">
            <form string="Conversation">
                <header>
                    <button name="action_take_over" type="object" string="Take over"
                            class="oe_highlight"
                            invisible="state not in ('ai_handling', 'pending_human')"/>
                    <button name="action_resume_ai" type="object" string="Resume AI"
                            invisible="state != 'human_handling'"/>
                    <button name="action_close" type="object" string="Close"
                            invisible="state == 'closed'"/>
                    <field name="state" widget="statusbar" statusbar_visible="ai_handling,pending_human,human_handling,closed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="partner_phone"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="phone_number_id"/>
                            <field name="partner_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="assigned_user_id"/>
                            <field name="handoff_reason" invisible="not handoff_reason"/>
                            <field name="last_message_at"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Transcript">
                            <field name="conversation_message_ids" widget="whatsapp_thread" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_whatsapp_conversation" model="ir.actions.act_window">
        <field name="name">Team Inbox</field>
        <field name="res_model">whatsapp.conversation</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'search_default_not_closed': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No conversations yet.
            </p>
            <p>
                Conversations appear here automatically as customers message
                you on WhatsApp. When the AI hands one off, it shows up under
                "Pending human" — take it over to start replying yourself.
            </p>
        </field>
    </record>

    <record id="view_whatsapp_conversation_search" model="ir.ui.view">
        <field name="name">whatsapp.conversation.search</field>
        <field name="model">whatsapp.conversation</field>
        <field name="arch" type="xml">
            <search string="Conversations">
                <field name="partner_phone"/>
                <field name="assigned_user_id"/>
                <filter string="Not closed" name="not_closed" domain="[('state', '!=', 'closed')]"/>
                <filter string="Assigned to me" name="assigned_to_me" domain="[('assigned_user_id', '=', uid)]"/>
                <filter string="Unassigned" name="unassigned" domain="[('assigned_user_id', '=', False)]"/>
                <group expand="0" string="Group by">
                    <filter string="State" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Assigned to" name="group_assigned" context="{'group_by': 'assigned_user_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <menuitem id="menu_whatsapp_conversation"
              name="Team Inbox"
              parent="menu_whatsapp_root"
              action="action_whatsapp_conversation"
              sequence="5"/>

</odoo>
<odoo>
    <record id="view_whatsapp_notification_template_list" model="ir.ui.view">
        <field name="name">whatsapp.notification.template.list</field>
        <field name="model">whatsapp.notification.template</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="template_key" groups="base.group_no_one"/>
                <field name="meta_template_name" optional="show"/>
                <field name="meta_status" optional="show" widget="badge"/>
                <field name="active"/>
                <button name="action_open_test_wizard" type="object"
                        string="Send Test" icon="fa-paper-plane"/>
            </list>
        </field>
    </record>

    <record id="view_whatsapp_notification_template_form" model="ir.ui.view">
        <field name="name">whatsapp.notification.template.form</field>
        <field name="model">whatsapp.notification.template</field>
        <field name="arch" type="xml">
            <form string="Notification Template">
                <header>
                    <button name="action_submit_to_meta" type="object"
                            string="Submit to Meta" class="btn-primary"
                            invisible="meta_status not in ('not_submitted', 'rejected')"/>
                    <button name="action_check_status" type="object"
                            string="Check Status" class="btn-secondary"
                            invisible="not meta_template_id"/>
                    <button name="action_open_test_wizard" type="object"
                            string="Send Test" class="btn-secondary"/>
                    <field name="meta_status" widget="badge"
                           decoration-success="meta_status == 'approved'"
                           decoration-danger="meta_status in ('rejected', 'disabled')"
                           decoration-warning="meta_status in ('pending', 'paused')"
                           decoration-muted="meta_status == 'not_submitted'"/>
                </header>
                <sheet>
                    <div class="alert alert-danger" role="alert" invisible="not meta_rejection_reason">
                        <field name="meta_rejection_reason" readonly="1" nolabel="1"/>
                    </div>
                    <group>
                        <field name="name"/>
                        <field name="template_key" groups="base.group_no_one"/>
                        <field name="active"/>
                    </group>
                    <group string="Message Body">
                        <field name="body" nolabel="1"
                               placeholder="Hi {name}, your order {order_name} is confirmed!"/>
                    </group>
                    <group string="Header / Footer">
                        <field name="header_type"/>
                        <field name="header_text" invisible="header_type != 'text'"/>
                        <field name="header_sample_media" filename="header_sample_media_filename"
                               invisible="header_type not in ('image', 'video', 'document')"
                               string="Header Sample File (for Meta review)"/>
                        <field name="header_sample_media_filename" invisible="1"/>
                        <field name="header_image_url" invisible="header_type not in ('image', 'video', 'document')"
                               string="Header Link (for sending, after approval)" placeholder="https://..."/>
                        <field name="footer_text"/>
                    </group>
                    <group string="Variables"
                           help="Sample values Meta shows reviewers. Refresh after editing the body.">
                        <button name="action_refresh_variables" type="object"
                                string="Refresh Variables" class="btn-link"/>
                        <field name="variable_ids" nolabel="1">
                            <list editable="bottom">
                                <field name="sequence" readonly="1"/>
                                <field name="placeholder_name" readonly="1"/>
                                <field name="sample_value"/>
                            </list>
                        </field>
                    </group>
                    <group string="Buttons" help="Up to 3. Static values only.">
                        <field name="button_ids" nolabel="1">
                            <list editable="bottom">
                                <field name="sequence" widget="handle"/>
                                <field name="button_type"/>
                                <field name="text"/>
                                <field name="value" invisible="button_type == 'quick_reply'"/>
                            </list>
                        </field>
                    </group>
                    <group string="Meta Approved Template"
                           help="Required to send this template to customers OUTSIDE the 24h session window (e.g. broadcasts), and to submit for review. Leave empty if only used for in-window replies/notifications.">
                        <field name="meta_template_name" placeholder="e.g. order_confirmed_v1"/>
                        <field name="meta_template_language" placeholder="en_US"/>
                        <field name="meta_category"/>
                        <field name="meta_template_id" readonly="1"/>
                        <field name="last_status_check" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_whatsapp_notification_template" model="ir.actions.act_window">
        <field name="name">Notification Templates</field>
        <field name="res_model">whatsapp.notification.template</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_whatsapp_notification_template" name="Notification Templates"
              parent="menu_whatsapp_root" action="action_whatsapp_notification_template" sequence="25"/>
</odoo>
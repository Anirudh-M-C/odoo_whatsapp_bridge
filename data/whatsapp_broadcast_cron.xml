<odoo>
    <record id="ir_cron_whatsapp_broadcast_sender" model="ir.cron">
        <field name="name">WhatsApp: Process Broadcast Campaigns</field>
        <field name="model_id" ref="model_whatsapp_broadcast_campaign"/>
        <field name="state">code</field>
        <field name="code">model._cron_process_broadcasts()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
        <field name="active">True</field>
    </record>
</odoo>